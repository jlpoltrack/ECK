#!/bin/sh
# Refuses a push carrying commits or tags whose emails aren't the GitHub noreply address (AGENTS.md).
# Install once per clone: git config core.hooksPath tools/git_hooks
ok='41841496+jlpoltrack@users.noreply.github.com'
zero=0000000000000000000000000000000000000000
bad=0
while read -r _ local_sha _ remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    if git log --format='%h %ae %ce' $range | grep -v " $ok $ok\$"; then bad=1; fi
    if [ "$(git cat-file -t "$local_sha")" = tag ] &&
        ! git cat-file -p "$local_sha" | grep -q "^tagger .*<$ok>"; then
        echo "tag $local_sha: tagger email isn't $ok"; bad=1
    fi
done
[ $bad = 0 ] || echo "pre-push: commits above use another email; set git config user.email $ok" >&2
exit $bad
