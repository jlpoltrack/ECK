+/* ---------- THROUGHPUT PROBE (test build, not committed) ----------
+ * VIA packets starting 0xE5 stay on the nRF52: [1] 1 = reset, 2 = data (counted), 3 = stats reply,
+ * 4 = request 2M PHY. Counts write requests vs commands and the link parameters the host grants. */
+#define PROBE_CMD 0xE5
+static uint32_t m_pr_writes, m_pr_req, m_pr_cmd, m_pr_bytes, m_pr_first, m_pr_last;
+
+static void probe_count(ble_gatts_evt_write_t const *w) {
+    if (w->handle != m_raw.outp_rep_array[0].char_handles.value_handle || w->len < 2 ||
+        w->data[0] != PROBE_CMD || w->data[1] != 2) {
+        return;
+    }
+    uint32_t now = app_timer_cnt_get();
+    if (!m_pr_writes) m_pr_first = now;
+    m_pr_last = now;
+    m_pr_writes++;
+    m_pr_bytes += w->len;
+    if (w->op == BLE_GATTS_OP_WRITE_REQ) m_pr_req++;
+    else if (w->op == BLE_GATTS_OP_WRITE_CMD) m_pr_cmd++;
+}
+
+static void probe_cmd(const uint8_t *d) {
+    latency_set(true);
+    (void)app_timer_stop(m_raw_timer);
+    APP_ERROR_CHECK(app_timer_start(m_raw_timer, APP_TIMER_TICKS(RAW_SESSION_MS), NULL));
+    if (d[1] == 1) {
+        m_pr_writes = m_pr_req = m_pr_cmd = m_pr_bytes = m_pr_first = m_pr_last = 0;
+    } else if (d[1] == 4) {
+        ble_gap_phys_t const phys = {.tx_phys = BLE_GAP_PHY_2MBPS, .rx_phys = BLE_GAP_PHY_2MBPS};
+        (void)sd_ble_gap_phy_update(m_conn_handle, &phys);
+    } else if (d[1] == 3) {
+        uint8_t r[RAW_REPORT_LEN] = {PROBE_CMD, 3};
+        uint32_t ticks = app_timer_cnt_diff_compute(m_pr_last, m_pr_first);
+        uint16_t mtu = nrf_ble_gatt_eff_mtu_get(&m_gatt, m_conn_handle);
+        uint8_t dl = 0;
+        (void)nrf_ble_gatt_data_length_get(&m_gatt, m_conn_handle, &dl);
+        memcpy(&r[2], &m_pr_writes, 4);
+        memcpy(&r[6], &m_pr_req, 4);
+        memcpy(&r[10], &m_pr_cmd, 4);
+        memcpy(&r[14], &m_pr_bytes, 4);
+        memcpy(&r[18], &ticks, 4);
+        memcpy(&r[22], &mtu, 2);
+        r[24] = dl;
+        r[25] = m_pr_tx_phy;
+        r[26] = m_pr_rx_phy;
+        memcpy(&r[27], &m_granted.max_conn_interval, 2);
+        memcpy(&r[29], &m_granted.slave_latency, 2);
+        r[31] = m_latency_off;
+        (void)ble_hids_inp_rep_send(&m_raw, 0, RAW_REPORT_LEN, r, m_conn_handle);
+    }
+}
